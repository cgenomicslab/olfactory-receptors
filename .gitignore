# Project-generated data and model artifacts
# These files are reproducible outputs or large reference downloads. Keep their
# creation/download instructions in the README rather than committing them.
/Model_Inputs/Embeddings/molecules/
/Model_Inputs/Embeddings/proteins/
/Chemicals/chembl/
/Chemicals/embeddings/
/Chemicals/odor_datasets/*embeddings*.npy

# The interactive Plotly versions of the embedding maps: ~4.6 MB each because plotly.js
# and every point are inlined, and between them they were 18% of the repository by
# Linguist's count. The notebooks that write them also write the SVG each figure
# actually uses, and those stay.
/Model_Inputs/Embeddings/figures/*.html

# The Leffingwell/GoodScents working files from the superseded ChEMBL background. Nothing
# reads them: chemspace/ builds its 5,962-molecule odorant set from its own committed
# data/reference_sets.csv, and the odour descriptors come from inchi_odors_smiles.csv.
/Chemicals/odor_datasets/leffingwell_goodscents_smiles.csv
/Chemicals/odor_datasets/leffingwell_goodscents_projected_on_chembl_umap.csv
/Chemicals/odor_datasets/molformer_leffingwell_goodscents_smiles.csv

# Manuscript drafting, not code. METHODS.md is paper text built up folder by folder as
# each analysis is finalised; it belongs with the manuscript, not here, and keeping one
# copy avoids the two drifting apart.
/METHODS.md

# The per-node runs packaged for Zenodo, kept next to the folder they came from. 1.15 GB,
# far over GitHub's 100 MB per-file limit, so it is local only. Rebuild it with
# prepare_zenodo_asr.py. The .sha256 beside it IS committed, so the archive can be checked
# after downloading it from Zenodo.
/Ancestral_Receptor_Reconstruction/asr_node_runs.zip

# Ancestral reconstruction. The 433 per-node IQ-TREE runs under NODE_*/ are ~11 GB of
# .state files and stay out. The handful of small files below do NOT: the rooted tree
# with internal node names is what every ancestral notebook walks, and without it
# `Downstream_Analysis/scripts/ancestral_sets.py` cannot even be imported. Together
# they are under 500 KB. Regenerating them needs the NODE_* runs, which is why they
# are committed rather than left to be rebuilt.
/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/*
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/PF13853_9606.7764.mafft.lg.treefile.rooted.withinternalnames
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/PF13853_9606.7764.mafft
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/hagfish_human_ASR.final.fasta
/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/hagfish.fa
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/asr_extract.py
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/tree.py
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/human_hagfish_tree.ipynb
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/human_hagfish_asr.ipynb
!/Ancestral_Receptor_Reconstruction/human_tree_asr_hagfish_outgroup/README.md
# COCONUT chemical-space run: the download and the large intermediates are gigabytes.
# The small s04/s06 CSVs and reports are kept, and so are the two small inputs the
# analysis cannot be reproduced without (the odorant list and the ChEMBL LDA axis).
/Chemicals/chemspace/data/*
!/Chemicals/chemspace/data/reference_sets.csv
!/Chemicals/chemspace/data/chembl_lda_structure.csv
/Chemicals/chemspace/results/*.npy
/Chemicals/chemspace/results/*.parquet
/Chemicals/chemspace/results/embed_index.csv
/Chemicals/chemspace/__pycache__/
# Prediction data comes from Zenodo, not Git: see Downstream_Analysis/README.md.
# ASR_Predictions_RefTree is re-included because it holds analysis code and small
# reference tables rather than model output.
/Downstream_Analysis/predictions/*
!/Downstream_Analysis/predictions/aggregated/
/Downstream_Analysis/predictions/aggregated/*
!/Downstream_Analysis/predictions/aggregated/ASR_Predictions_RefTree/
# Zenodo upload staging for the whole record (predictions + embeddings).
/release/

# Common phylogenetic inference and checkpoint outputs. These patterns exist mainly to
# keep the 433 per-node ASR runs out; they are deliberately broad.
*.ckp.gz
*.iqtree
*.state
*.treefile
*.contree
*.mldist

# ...but the published trees are results, not working files, and a paper repository has
# to carry them. These are the inferred trees themselves plus the IQ-TREE reports that
# record model selection for the Methods section. All small. The checkpoints (.ckp.gz),
# distance matrices (.mldist) and run logs stay out.
!/Phylogenetic_Analysis/data/HumanTree/human433_MFP.treefile
!/Phylogenetic_Analysis/data/HumanTree/human433_MFP.contree
!/Phylogenetic_Analysis/data/HumanTree/human433_MFP.iqtree
!/Phylogenetic_Analysis/data/ReferenceTree/*.treefile
!/Phylogenetic_Analysis/data/ReferenceTree/*.iqtree

# ---------------------------------------------------------------------------
# Not in the manuscript.
#
# Everything below is real work that is kept locally but is not cited by any
# figure, table or Methods paragraph of "Gene duplication shaped the origin and
# evolution of the vertebrate olfactory combinatorial code". A reader arriving
# from the paper should find only the analysis the paper stands on, so these
# are untracked rather than deleted.
# ---------------------------------------------------------------------------

# Sparse-autoencoder feature interpretation over the ESM-C representations.
# Exploratory throughout; no figure, panel or Methods section uses it.
/Model_Inputs/Embeddings/*sae*
/Model_Inputs/Embeddings/*SAE*
/Model_Inputs/Embeddings/figures/*sae*
/Model_Inputs/Embeddings/figures/*SAE*

# The earlier ChEMBL background. Superseded by the COCONUT natural-product
# background in Chemicals/chemspace/, which is what Fig. 4 reports, and neither
# notebook runs on a fresh clone without the gitignored ~10 GB downloads.
# The discriminant axis they produced is still used by s04's Q2 comparison, so
# Chemicals/chemspace/data/chembl_lda_structure.csv stays tracked.
/Chemicals/chembl_molecules.ipynb
/Chemicals/odorant_chemical_space.ipynb

# Loose exploratory notebooks that predate the numbered reference_tree/ and
# ancestral/ series. They cross-reference each other and nothing else; every
# result the paper reports was redone in the numbered notebooks.
/Downstream_Analysis/notebooks/OR_ASR_functional_evolution.ipynb
/Downstream_Analysis/notebooks/logp_transitions_human_ancestors.ipynb
/Downstream_Analysis/notebooks/logP_by_groups.png
/Downstream_Analysis/notebooks/m2or_molecules_per_class.ipynb
/Downstream_Analysis/notebooks/paris.ipynb
/Downstream_Analysis/notebooks/stiatistics_on_chemicals.ipynb

# An older reference-tree ancestral prediction set, orphaned: nothing in the
# repository reads it, and the paper's ancestral analysis runs on the 432-node
# human-tree matrix instead.
/Downstream_Analysis/predictions/aggregated/ASR_Predictions_RefTree/

# Superseded whole-repository results dump, replaced by the manuscript itself.
/results_overview.html
/results_overview.pdf

# The preprint PDF itself. It lives on bioRxiv; no reason to carry 4.3 MB of it here.
/2026.08.31.747588v1.full.pdf

# Local editor and tooling settings, not part of the analysis.
/.vscode/

# s12's full habitat table: one row per COCONUT molecule, ~15 MB. The panel-sized slice
